{
  "name": "daymath",
  "version": "0.2.2",
  "description": "Calendar date math (ISO 8601 day / PlainDate). date-fns-shaped. No time zones.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=index.js test.js",
    "prepublishOnly": "npm run test:coverage"
  },

  "keywords": [
    "date",
    "calendar",
    "plain-date",
    "temporal",
    "date-fns",
    "YYYY-MM-DD",
    "ISO-8601",
    "PlainDate"
  ],
  "author": "leemr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leemr/daymath.git"
  },
  "bugs": {
    "url": "https://github.com/leemr/daymath/issues"
  },
  "homepage": "https://leemr.github.io/daymath/",
  "sideEffects": false,
  "dependencies": {
    "temporal-polyfill": "^1.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
